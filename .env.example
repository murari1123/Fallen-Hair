# -------------------------------------------------------------
# FALLEN HAIR — Environment Configuration (JIGS V3)
# -------------------------------------------------------------

# Client-Side Variables (Inlined at build time by Vite)
# NEVER put API keys or service role secrets in VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
VITE_ENABLE_JIGS_AI=true

# Server-Side Only Secrets (Used by Vercel Serverless Functions in /api)
# NEVER prefix these with VITE_ or import them into client code

# Supabase Server-Side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Gemini Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Configuration (Optional secondary provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Orchestrator Mode ('auto' | 'gemini' | 'groq')
AI_PROVIDER_MODE=auto

# Session Security (Cryptographic HMAC secret for JIGS session tokens)
JIGS_SESSION_SECRET=your_random_64_character_hex_secret_here

# Optional Security / Rate Limiting Controls
# JIGS_MAX_MESSAGE_LENGTH=1500
# JIGS_RATE_LIMIT_REQUESTS=30
# JIGS_RATE_LIMIT_WINDOW=60000
# JIGS_AI_DAILY_SOFT_LIMIT=500
